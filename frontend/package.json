  "scripts": {
    "test": "node app.test.js && node --test --test-concurrency=1 state.test.js dom.test.js",
    "test:state": "node --test --test-concurrency=1 state.test.js",
    "test:dom": "node --test --test-concurrency=1 dom.test.js",
