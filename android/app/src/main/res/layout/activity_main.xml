<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hero_eyebrow" android:textColor="@color/lime" android:textStyle="bold"/>
    <TextView android:id="@+id/hero_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/hero_title" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/hero_body" android:textColor="@color/muted"/>
    <TextView android:id="@+id/api_url_label" style="@style/SectionLabel" android:layout_marginTop="24dp" android:labelFor="@id/api_url" android:text="@string/api_base_label"/>
    <EditText android:id="@+id/api_url" style="@style/Input" android:hint="@string/api_base_hint" android:inputType="textUri" android:maxLines="1" android:minHeight="48dp"/>
    <CheckBox android:id="@+id/auth_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_enabled" android:textColor="@color/ink"/>
    <TextView android:id="@+id/bearer_label" style="@style/SectionLabel" android:labelFor="@id/bearer" android:text="@string/bearer_label" android:visibility="gone"/>
    <EditText android:id="@+id/bearer" style="@style/Input" android:hint="@string/bearer_hint" android:inputType="textPassword" android:maxLines="1" android:minHeight="48dp" android:visibility="gone"/>
    <TextView android:id="@+id/targets_heading" style="@style/SectionLabel" android:layout_marginTop="22dp" android:text="@string/targets_label"/>
    <LinearLayout android:id="@+id/targets" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <Button android:id="@+id/add_target" style="@style/SecondaryButton" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/add_target"/>
    <TextView android:id="@+id/timeout_label" style="@style/SectionLabel" android:layout_marginTop="20dp" android:labelFor="@id/timeout" android:text="@string/timeout_label"/>
    <EditText android:id="@+id/timeout" style="@style/Input" android:hint="@string/timeout_hint" android:inputType="number" android:maxLines="1" android:minHeight="48dp" android:text="5000"/>
    <Button android:id="@+id/run" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:minHeight="48dp" android:text="@string/run"/>
    <Button android:id="@+id/cancel" style="@style/SecondaryButton" android:minHeight="48dp" android:text="@string/cancel" android:visibility="gone"/>
    <Button android:id="@+id/retry" style="@style/SecondaryButton" android:minHeight="48dp" android:text="@string/retry" android:visibility="gone"/>
    <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone"/>
    <TextView android:id="@+id/request_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:focusable="true" android:padding="12dp" android:text="@string/state_idle" android:textColor="@color/ink"/>
    <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="assertive" android:focusable="true" android:padding="14dp" android:textColor="#FFAA9E" android:visibility="gone"/>
    <LinearLayout android:id="@+id/report" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@color/panel" android:focusable="true" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/share" style="@style/SecondaryButton" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/share"/>
        <TextView android:id="@+id/raw_privacy_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/raw_share_privacy_warning" android:textColor="@color/muted"/>
        <Button android:id="@+id/share_raw" style="@style/SecondaryButton" android:enabled="false" android:minHeight="48dp" android:text="@string/share_raw"/>
    </LinearLayout>
</LinearLayout></ScrollView>
