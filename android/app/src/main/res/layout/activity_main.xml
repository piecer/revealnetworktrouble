<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="NETWORK DIAGNOSTICS"
            android:textColor="@color/lime"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="문제가 생긴 곳을\n한 번에 확인하세요."
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DNS, TCP 연결, 웹 서비스를 검사하고 공유 가능한 리포트를 만듭니다."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="32dp"
            android:text="API 서버" />

        <EditText
            android:id="@+id/api_url"
            style="@style/Input"
            android:hint="https://api.example.com"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="28dp"
            android:text="검사 대상" />

        <LinearLayout
            android:id="@+id/targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/add_target"
            style="@style/SecondaryButton"
            android:layout_marginTop="10dp"
            android:text="+ 검사 대상 추가" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="제한 시간 (ms)"
                android:textColor="@color/muted" />

            <EditText
                android:id="@+id/timeout"
                style="@style/Input"
                android:layout_width="110dp"
                android:inputType="number"
                android:maxLines="1"
                android:text="5000" />
        </LinearLayout>

        <Button
            android:id="@+id/run"
            style="@style/PrimaryButton"
            android:layout_marginTop="18dp"
            android:text="진단 시작  →" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/lime"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#2D1714"
            android:padding="14dp"
            android:textColor="#FFAA9E"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/panel"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/report_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lime"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/report_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted" />

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/share"
                style="@style/SecondaryButton"
                android:layout_marginTop="16dp"
                android:text="JSON 리포트 공유" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
