<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:paddingBottom="4dp">
    <Spinner android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:spinnerMode="dropdown"/>
    <TextView android:id="@+id/address_label" style="@style/SectionLabel" android:layout_marginTop="4dp" android:labelFor="@id/address" android:text="@string/address_label"/>
    <EditText android:id="@+id/address" style="@style/Input" android:layout_width="match_parent" android:hint="@string/hint_dns" android:inputType="textUri" android:maxLines="1" android:minHeight="48dp"/>
    <TextView android:id="@+id/expected_status_label" style="@style/SectionLabel" android:labelFor="@id/expected_status" android:text="@string/expected_status_label" android:visibility="gone"/>
    <EditText android:id="@+id/expected_status" style="@style/Input" android:layout_width="match_parent" android:hint="@string/expected_status_hint" android:inputType="number" android:maxLines="1" android:minHeight="48dp" android:visibility="gone"/>
    <TextView android:id="@+id/attempts_label" style="@style/SectionLabel" android:labelFor="@id/attempts" android:text="@string/attempts_label" android:visibility="gone"/>
    <EditText android:id="@+id/attempts" style="@style/Input" android:layout_width="match_parent" android:hint="@string/attempts_hint" android:inputType="number" android:maxLines="1" android:minHeight="48dp" android:visibility="gone"/>
    <Button android:id="@+id/remove" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remove_symbol"/>
</LinearLayout>
